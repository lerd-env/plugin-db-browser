#!/usr/bin/env node
// Stands in for `lerd db:shell`, printing what the mysql client prints in batch
// mode, or psql's csv output for the postgres service. Databases: the site's
// default and mysql/shop hold users, mariadb-app/legacy holds orders,
// postgres/blog holds posts. FAKE_NO_DB=1 is a server with no database picked.
// FAKE_LOG names a file each call's arguments are appended to.
const fs = require('node:fs');
const args = process.argv.slice(2);
if (process.env.FAKE_LOG) fs.appendFileSync(process.env.FAKE_LOG, args.join(' ') + '\n');
const flag = (name) => (args.find((a) => a.startsWith(`--${name}=`)) || '').split('=').slice(1).join('=');
const service = flag('service');
const database = flag('database');
const sql = fs.readFileSync(0, 'utf8');

function fail(msg) {
  process.stderr.write(msg + '\n');
  process.exit(1);
}

if (service === 'postgres') {
  if (database !== 'blog') fail(`FATAL:  database "${database}" does not exist`);
  const csv = (lines) => process.stdout.write(lines.map((l) => l.join(',')).join('\n') + '\n');
  if (/version\(\)/.test(sql)) csv([['version'], ['PostgreSQL 16.4']]);
  else if (/information_schema\.tables/.test(sql)) csv([['table_schema', 'table_name', 'table_type'], ['public', 'posts', 'BASE TABLE']]);
  else if (/information_schema\.columns c/.test(sql)) csv([['column_name', 'data_type', 'is_nullable', 'column_default', '?column?'], ['id', 'integer', 'NO', '', 't'], ['title', 'text', 'YES', '', 'f']]);
  else if (/pg_indexes/.test(sql)) csv([['indexname', 'indexdef'], ['posts_pkey', 'CREATE UNIQUE INDEX posts_pkey ON public.posts USING btree (id)']]);
  else if (/pg_constraint/.test(sql)) csv([['conname', 'pg_get_constraintdef'], ['posts_user_fk', 'FOREIGN KEY (user_id) REFERENCES users(id)']]);
  else if (/COUNT\(\*\) FROM "public"\."posts"/.test(sql)) csv([['count'], ['1']]);
  else if (/FROM "public"\."posts" ORDER BY "id" ASC LIMIT/.test(sql)) csv([['id', 'title'], ['1', 'Hello']]);
  else fail('ERROR:  fake-lerd does not know this query');
  process.exit(0);
}

const out = (lines) => process.stdout.write(lines.map((l) => l.join('\t')).join('\n') + '\n');
const noDB = process.env.FAKE_NO_DB === '1';
const users = [['1', 'ana'], ['2', 'NULL'], ['3', 'tab\\there']];
const db = service === 'mariadb-app' ? 'legacy' : 'shop';
if (service && database !== db) fail(`ERROR 1049 (42000): Unknown database '${database}'`);

if (/version\(\)/.test(sql)) out([['version()'], ['8.4.0']]);
else if (/SELECT DATABASE\(\)/.test(sql)) out([['DATABASE()'], [noDB ? 'NULL' : db]]);
else if (/information_schema\.TABLES/.test(sql)) {
  if (noDB) process.exit(0);
  if (db === 'legacy') out([['TABLE_NAME', 'TABLE_TYPE'], ['orders', 'BASE TABLE']]);
  else out([['TABLE_NAME', 'TABLE_TYPE'], ['users', 'BASE TABLE'], ['active_users', 'VIEW']]);
} else if (/information_schema\.COLUMNS/.test(sql)) {
  out([['COLUMN_NAME', 'COLUMN_TYPE', 'IS_NULLABLE', 'COLUMN_DEFAULT', 'COLUMN_KEY'], ['id', 'int', 'NO', 'NULL', 'PRI'], ['name', 'varchar(40)', 'YES', 'NULL', '']]);
} else if (/information_schema\.STATISTICS/.test(sql)) out([['INDEX_NAME', 'NON_UNIQUE', 'cols'], ['PRIMARY', '0', 'id']]);
else if (/information_schema\.KEY_COLUMN_USAGE/.test(sql)) process.exit(0);
else if (/FROM `users`/.test(sql)) {
  // Just enough SQL for the plugin's own pages: one = or LIKE filter on name,
  // an order on one column, and LIMIT/OFFSET.
  let rows = users.slice();
  const where = sql.match(/WHERE `name` (=|LIKE) '(.*?)'/);
  if (where) {
    const re = new RegExp('^' + where[2].replace(/%/g, '.*') + '$');
    rows = rows.filter((r) => r[1] !== 'NULL' && re.test(r[1]));
  }
  const order = sql.match(/ORDER BY `(\w+)` (ASC|DESC)/);
  if (order) {
    const i = order[1] === 'id' ? 0 : 1;
    rows.sort((a, b) => a[i].localeCompare(b[i]) * (order[2] === 'DESC' ? -1 : 1));
  }
  if (/COUNT\(\*\)/.test(sql)) out([['COUNT(*)'], [String(rows.length)]]);
  else {
    const [, limit, offset] = sql.match(/LIMIT (\d+) OFFSET (\d+)/).map(Number);
    rows = rows.slice(offset, offset + limit);
    if (rows.length) out([['id', 'name'], ...rows]);
  }
} else fail('ERROR 1064 (42000): fake-lerd does not know this query');
