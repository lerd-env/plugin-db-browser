#!/usr/bin/env node
// POST /api/plugins/db-browser/db?site=<site>
// {action: "tables", service?, database?} opens one of the site's databases,
// remembering the pick, and lists its tables; {action: "rows", table, schema,
// offset, service?, database?} answers one page of a table; {action:
// "page_size", size} remembers how many rows a page shows; {action:
// "structure", table, schema} answers a table's columns, indexes and keys.
// rows also takes sort {column, dir} and filter {column, op, value}.
// {action: "query", sql, confirm?} runs one statement: a read at once, capped
// at CAP rows; a write only with confirm, answering {confirm} until then.
// {action: "history"} lists the site's last queries.
// {action: "apply", table, schema, changes, confirm?} applies staged edits in
// one transaction, answering {confirm, statements} until confirmed.
const fs = require('node:fs');
const { withEngine, databaseName, tables, openTable, page, structure, query, applyAll } = require('../lib/db');
const { OPERATORS, buildChanges } = require('../lib/sql');
const { connectionsFor, pickConnection } = require('../lib/connections');
const { PAGE_SIZES, readSettings, savePageSize, saveConnection, saveFamilies } = require('../lib/settings');
const { api } = require('../lib/lerd');
const { singleStatement, isRead, capRows } = require('../lib/statement');
const { readHistory, addHistory } = require('../lib/history');

const CAP = 1000;

const DATA = process.env.LERD_PLUGIN_DATA;

function readBody() {
  const text = fs.readFileSync(0, 'utf8');
  return text ? JSON.parse(text) : {};
}

// The engine of each service the site uses, from the remembered answers when
// they cover them all, and from lerd otherwise.
async function serviceFamilies(site) {
  const known = readSettings(DATA).families;
  const wanted = (site.databases ?? []).map((d) => d.service);
  if (wanted.every((name) => known[name])) return wanted.map((service) => ({ service, family: known[service] }));
  const all = await api('/api/databases');
  saveFamilies(DATA, Object.fromEntries(all.map((s) => [s.service, s.family])));
  return all;
}

// The connection a request may use: one of the site's own, checked against
// what lerd lists rather than what the request says.
async function connect(body) {
  const siteName = process.env.LERD_SITE;
  const sitePath = process.env.LERD_SITE_PATH;
  if (!siteName || !sitePath) throw new Error('pick a site: ?site=<name>');
  const site = (await api('/api/sites')).find((s) => s.name === siteName);
  if (!site) throw new Error(`lerd lists no site ${siteName}`);
  const services = await serviceFamilies(site);
  const list = connectionsFor(site, services);
  const requested = body.service ? { service: String(body.service), database: String(body.database ?? '') } : null;
  const { conn, notice } = pickConnection(list, requested, readSettings(DATA).connections[siteName]);
  if (requested && body.action === 'tables') saveConnection(DATA, siteName, conn);
  return { conn: withEngine({ sitePath, ...conn }), list, notice };
}

function runQuery(conn, connection, sql, confirmed) {
  const statement = singleStatement(sql);
  const read = isRead(statement);
  if (!read && !confirmed) {
    return { connection, confirm: `This statement can change ${databaseName(conn) ?? 'the database'}. Run it?`, sql: statement };
  }
  const started = Date.now();
  const result = query(conn, read ? capRows(statement, CAP) : statement, { write: !read });
  const ms = Date.now() - started;
  addHistory(DATA, process.env.LERD_SITE, statement);
  const truncated = result.rows.length > CAP;
  if (truncated) result.rows.length = CAP;
  return { engine: conn.engine, connection, read, ms, truncated, cap: CAP, ...result };
}

function applyChanges(conn, connection, table, columns, changes, confirmed) {
  if (table.view) throw new Error(`${table.name} is a view, so its rows cannot be edited here`);
  const statements = buildChanges({ engine: conn.engine, table, columns, changes });
  if (!confirmed) {
    const n = statements.length;
    return { connection, confirm: `Apply ${n} ${n === 1 ? 'change' : 'changes'} to ${table.name}?`, statements };
  }
  applyAll(conn, statements);
  return { connection, applied: statements.length };
}

async function main() {
  const body = readBody();
  if (body.action === 'page_size') {
    savePageSize(DATA, Number(body.size));
    return { pageSize: readSettings(DATA).pageSize };
  }
  if (body.action === 'history') return { history: readHistory(DATA, process.env.LERD_SITE) };
  if (!['tables', 'rows', 'structure', 'query', 'apply'].includes(body.action)) throw new Error(`unknown action ${body.action}`);
  const { conn, list, notice } = await connect(body);
  const connection = { service: conn.service, database: conn.database, engine: conn.engine };
  if (body.action === 'tables') {
    return {
      engine: conn.engine, connection, connections: list, notice,
      database: databaseName(conn), tables: tables(conn),
      pageSize: readSettings(DATA).pageSize, pageSizes: PAGE_SIZES, operators: OPERATORS,
    };
  }
  if (body.action === 'query') return runQuery(conn, connection, String(body.sql ?? ''), body.confirm === true);
  const { table, columns } = openTable(conn, String(body.table ?? ''), String(body.schema ?? ''));
  if (body.action === 'apply') return applyChanges(conn, connection, table, columns, body.changes, body.confirm === true);
  if (body.action === 'structure') return { engine: conn.engine, connection, ...structure(conn, table, columns) };
  const limit = readSettings(DATA).pageSize;
  const offset = Math.max(0, Number.parseInt(body.offset, 10) || 0);
  return { engine: conn.engine, connection, offset, limit, ...page(conn, table, columns, { limit, offset, sort: body.sort, filter: body.filter }) };
}

main().then(
  (out) => process.stdout.write(JSON.stringify(out)),
  (e) => {
    console.error(e.message);
    process.exit(1);
  },
);
